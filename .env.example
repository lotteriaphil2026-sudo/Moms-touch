APP_NAME="Mom’s Touch Portal"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://portal.example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Use a dedicated, durable database with row-lock support for wallet operations.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=momstouch_portal
DB_USERNAME=momstouch_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Generate credentials with `php artisan portal:push-keys`; keep the private key secret.
# A queue worker must be running for phone push notifications to be delivered.
# Some Windows PHP builds also need OPENSSL_CONF set to their OpenSSL config file.
WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.com
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=

# Configure your SMTP provider; smtp on 587 uses STARTTLS, smtps on 465 uses TLS.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Open registration only after publishing the operator's final policies.
PORTAL_REGISTRATION_ENABLED=false
# Internal ledger only. Enabling this does not connect bank payments or payouts.
PORTAL_FINANCIAL_OPERATIONS_ENABLED=false
# Set to true only for a non-payable demo QR environment.
PORTAL_DEPOSIT_QR_DEMO_MODE=false
# Set a private random value (at least 32 characters) to enable admin member classification.
ADMIN_MEMBER_CLASSIFICATION_KEY=
